# ==============================================================================
# ReleaseTrace Environment Configuration Template
# ==============================================================================

# Application & Host
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. Database (Neon PostgreSQL + Prisma)
# ------------------------------------------------------------------------------
# Direct connection used for migrations (Prisma CLI)
DIRECT_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Pooled connection used for Next.js App runtime
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# ------------------------------------------------------------------------------
# 2. Hindsight by Vectorize (Persistent Semantic Memory)
# ------------------------------------------------------------------------------
# Base URL for Hindsight Cloud or self-hosted deployment
HINDSIGHT_BASE_URL="https://api.hindsight.vectorize.io"
# Hindsight API Key
HINDSIGHT_API_KEY=""
# Prefix for project-specific memory banks (e.g. releasetrace)
HINDSIGHT_BANK_PREFIX="releasetrace"

# ------------------------------------------------------------------------------
# 3. Groq LLM Provider
# ------------------------------------------------------------------------------
GROQ_API_KEY=""
# Configurable model (evaluates openai/gpt-oss-120b, qwen/qwen3-32b, or llama-3.3-70b-versatile)
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_TIMEOUT_MS=15000

# ------------------------------------------------------------------------------
# 4. Ingestion Webhook Security (GitHub Actions)
# ------------------------------------------------------------------------------
# Shared secret for HMAC-SHA256 signature verification
RELEASETRACE_WEBHOOK_SECRET="replace-with-a-secure-random-secret-key-32-chars-minimum"
RELEASETRACE_ENDPOINT="http://localhost:3000/api/webhooks/deployments"

# ------------------------------------------------------------------------------
# 5. Inngest Durable Workflows
# ------------------------------------------------------------------------------
INNGEST_EVENT_KEY="local"
INNGEST_SIGNING_KEY=""

# ------------------------------------------------------------------------------
# 6. Vercel Integration (Optional read-only for correlation)
# ------------------------------------------------------------------------------
VERCEL_API_TOKEN=""
VERCEL_TEAM_ID=""
VERCEL_PROJECT_ID=""
