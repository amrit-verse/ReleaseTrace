datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Workspace {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]

  @@map("workspaces")
}

model Project {
  id              String         @id @default(uuid())
  workspaceId     String
  name            String
  slug            String
  repository      String
  hindsightBankId String         @unique
  vercelProjectId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integrations    Integration[]
  deployments     Deployment[]
  webhookEvents   WebhookEvent[]
  auditLogs       AuditLog[]

  @@unique([workspaceId, slug])
  @@index([repository])
  @@map("projects")
}

model Integration {
  id                String   @id @default(uuid())
  projectId         String
  provider          String
  enabled           Boolean  @default(true)
  webhookSecretHash String?
  encryptedConfig   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, provider])
  @@map("integrations")
}

model WebhookEvent {
  id             String    @id @default(uuid())
  projectId      String
  provider       String
  eventId        String
  idempotencyKey String    @unique
  eventType      String
  payload        Json
  processed      Boolean   @default(false)
  processedAt    DateTime?
  error          String?
  createdAt      DateTime  @default(now())
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, provider])
  @@index([createdAt])
  @@map("webhook_events")
}

model Deployment {
  id                   String      @id @default(uuid())
  projectId            String
  provider             String
  providerDeploymentId String
  commitSha            String
  branch               String
  environment          String
  status               String
  evidence             Json
  url                  String?
  startedAt            DateTime
  completedAt          DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  project              Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assessment           Assessment?
  resolution           Resolution?

  @@unique([projectId, providerDeploymentId])
  @@index([projectId, commitSha])
  @@index([projectId, status])
  @@index([createdAt])
  @@map("deployments")
}

model Assessment {
  id                    String            @id @default(uuid())
  deploymentId          String            @unique
  overallCategory       String
  summary               String
  findings              Json
  environmentComparison Json
  groundedExplanation   String
  recommendedAction     String
  checklist             Json
  llmModel              String
  llmDurationMs         Int
  validatedWithZod      Boolean           @default(true)
  fallbackUsed          Boolean           @default(false)
  createdAt             DateTime          @default(now())
  deployment            Deployment        @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  resolutions           Resolution[]
  memoryReferences      MemoryReference[]

  @@index([overallCategory])
  @@index([createdAt])
  @@map("assessments")
}

model Resolution {
  id                  String     @id @default(uuid())
  assessmentId        String
  deploymentId        String     @unique
  engineerName        String
  engineerEmail       String?
  confirmedRootCause  String
  appliedFix          String
  preventionGuideline String
  outcome             String
  retainedToHindsight Boolean    @default(false)
  hindsightMemoryId   String?
  retentionTags       String[]
  resolvedAt          DateTime   @default(now())
  assessment          Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  deployment          Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@map("resolutions")
}

model MemoryReference {
  id               String     @id @default(uuid())
  assessmentId     String
  hindsightBankId  String
  externalMemoryId String
  relevanceScore   Float?
  memoryType       String?
  snippet          String
  createdAt        DateTime   @default(now())
  assessment       Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([hindsightBankId, externalMemoryId])
  @@index([assessmentId])
  @@map("memory_references")
}

model AuditLog {
  id         String   @id @default(uuid())
  projectId  String
  actor      String
  action     String
  targetType String
  targetId   String
  details    Json
  ipAddress  String?
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([action])
  @@map("audit_logs")
}
